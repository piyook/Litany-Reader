# Git sends "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref on
# stdin. Validate the remote branch names being pushed, skipping deletions (all-zero
# local sha) and tags, so detached HEADs and `git push origin other-branch` work.
branches=""
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac
	case "$remote_ref" in refs/heads/*) branches="$branches ${remote_ref#refs/heads/}" ;; esac
done
if [ -n "$branches" ]; then
	npm run validate-branch-name -- $branches
fi

# Compare against the real main, not a stale local copy.
git fetch --quiet origin main
npx biome ci
# The tests go before fallow, which scores complexity from the coverage they
# write. They fail below the minimum in vitest.config.mjs.
npm run test:coverage
npx fallow audit --base origin/main
# The reader in a real browser (about 10 seconds). Needs `npx playwright install chromium` once.
npm run test:e2e
npm audit --omit=dev
