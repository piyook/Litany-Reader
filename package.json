{
  "name": "litany-reader",
  "version": "1.7.4",
  "private": true,
  "license": "MIT",
  "description": "Shows a litany one line at a time, paced to guide calm breathing.",
  "scripts": {
    "start": "node scripts/start.js",
    "stop": "node scripts/stop.js",
    "restart": "node scripts/stop.js && node scripts/start.js",
    "serve": "node server.js",
    "build": "node scripts/build-static.js",
    "docker:start": "node scripts/docker.js start",
    "docker:stop": "node scripts/docker.js stop",
    "docker:logs": "docker compose logs -f",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "fallow": "fallow audit --base origin/main",
    "quality": "biome ci && vitest run --coverage && fallow audit --base origin/main && playwright test && npm audit --omit=dev",
    "prepare": "husky",
    "validate-branch-name": "node scripts/validate-branch-name.js",
    "version": "node scripts/write-version.js && git add public/version.js"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.0",
    "@vitest/coverage-v8": "^5.1.0",
    "fallow": "3.39.0",
    "husky": "^9.1.7",
    "vitest": "^5.1.0"
  }
}
