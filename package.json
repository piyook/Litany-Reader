{
  "name": "litany-reader",
  "version": "1.3.1",
  "private": true,
  "license": "MIT",
  "description": "Shows a litany one line at a time, paced to guide calm breathing.",
  "scripts": {
    "start": "node scripts/start.js",
    "stop": "node scripts/stop.js",
    "restart": "node scripts/stop.js && node scripts/start.js",
    "serve": "node server.js",
    "build": "node scripts/build-static.js",
    "docker:start": "node scripts/docker.js start",
    "docker:stop": "node scripts/docker.js stop",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=18"
  }
}
